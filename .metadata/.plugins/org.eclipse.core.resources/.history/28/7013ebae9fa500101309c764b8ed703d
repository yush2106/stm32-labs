//display number
int DisplayNumber = 1234;
//array of register hex number
int LED_Hex[] = {
  0x3F,    // 0
  0x06,    // 1
  0x5B,    // 2
  0x4F,    // 3
  0x66,    // 4
  0x6D,    // 5
  0x7D,    // 6
  0x07,    // 7
  0x7F,    // 8
  0x6F     // 9
};
//Digit Array
int DigitArray[] = {digit1, digit2, digit3, digit4};
//Reset all digits
void ResetAllDigits() {
  int DigitLength = sizeof(DigitArray) / sizeof(DigitArray[0]);    //digit length
  for(int i = 0; i < DigitLength; i++) {
    HAL_GPIO_WritePin(GPIOC, DigitArray[i], GPIO_PIN_RESET);    //disabled
  }
}

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin) {
  //button 1 to increase number
  if(GPIO_Pin == Increase) {
    DisplayNumber++;
    if(DisplayNumber > 9999) {
      DisplayNumber = 0;
    }
  }
  //button 2 to decrease number
  else if(GPIO_Pin == Decrease) {
    DisplayNumber--;
	if(DisplayNumber < 0) {
      DisplayNumber = 0;
    }
  }
}
