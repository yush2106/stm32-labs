//enable and disable
void LCD_Strobe() {
	HAL_GPIO_WritePin(GPIOA, LCD_EN, GPIO_PIN_SET);    //Enable = 1
	HAL_Delay(0.1);    //delay
	HAL_GPIO_WritePin(GPIOA, LCD_EN, GPIO_PIN_RESET);    //Enable = 0
	HAL_Delay(0.1);    //delay
}

//write command
void LCD_Write_Cmd(unsigned char c) {
	unsigned int d;

	d = c;
	d = (d << 4) & 0x0F00;    //shift left 4 position and mask
	GPIOA > ODR = d;    //write to register
	HAL_GPIO_Write_Pin(GPIOA, LCD_RS, GPIO_PIN_RESET);    //RS=0, write to command type
	LCD_Strobe();    //enable and disable

	d = c;
	d = (d << 8) & 0x0F00;    //shift left 8 position and mask
	GPIOA > ODR = d;    //write to register
	HAL_GPIO_Write_Pin(GPIOA, LCD_RS, GPIO_PIN_RESET);    //RS=0, write to command type
	LCD_Strobe();    //enable and disable
	HAL_Delay(0.1);
}

//write data
void LCD_Write_Data(unsigned char c) {
	unsigned int d;

	d = c;
	d = (d << 4) & 0x0F00;    //shift left 4 position and mask
	GPIOA > ODR = d;    //write to register
	HAL_GPIO_Write_Pin(GPIOA, LCD_RS, GPIO_PIN_SET);    //RS=1, write to data type
	LCD_Strobe();    //enable and disable

	d = c;
	d = (d << 8) & 0x0F00;    //shift left 8 position and mask
	GPIOA > ODR = d;    //write to register
	HAL_GPIO_Write_Pin(GPIOA, LCD_RS, GPIO_PIN_SET);    //RS=1, write to data type
	LCD_Strobe();    //enable and disable
	HAL_Delay(0.1);
}

//clear lcd
void Clear_LCD() {
	LCD_Write_Cmd(0x01);    //clear lcd
	HAL_Delay(5);
}

//write
void LCD_PutChar(const char *s) {
	while(*s) {
		LCD_Write_Data(*s++);
	}
}
