float DAC_Range = 4095.0;    //12-bit range
#define DataCount 100    //sample data
uint8_t wave_type = 0;
uint8_t value_index = 0;
uint8_t lcd_flag = 0;

uint32_t sawtooth_wave[DataCount];    //sawtooth wave data
uint32_t square_wave[DataCount];    //square wave data
uint32_t sine_wave[DataCount];    //sine wave data
uint32_t trapezoidal_wave[DataCount];    //trapezoidal wave data
uint32_t triangular_wave[DataCount];    //triangular wave data

//LED Array
uint8_t LED_Array[] = {led0,led1,led2,led3,led4};

//sawtooth wave
void set_sawtooth_wave() {
  //get each step value
  for(int i = 0; i < DataCount; i++){
	sawtooth_wave[i] = (float)i / (float)DataCount * DAC_Range;
  }
}

//square wave
void set_square_wave() {
  //get each step value
  for(int i = 0; i < DataCount; i++){
	if(i < DataCount * 0.5) {
	  square_wave[i] = 0;
	}
	else {
	  square_wave[i] = 1 * DAC_Range;
	}
  }
}

//sine wave
void set_sine_wave() {
  float step = 2.0 * M_PI / DataCount;    //step
  for(int i = 0; i < DataCount; i++) {
    float radian = i * step;    //radian
    float sine_value = sin(radian);        //value range -1 ~ +1
    sine_wave[i] = (sine_value + 1.0) / 2.0 * DAC_Range;    //convert value range to 0 ~ 1
  }
}

//trapezoidal wave
void set_trapezoidal_wave() {
  for(int i = 0; i < DataCount; i++) {
	if(i < DataCount * 0.25) {
	  trapezoidal_wave[i] = (DataCount / (DataCount * 0.25) * i) / DataCount * DAC_Range;
	}
	else if(i >= DataCount * 0.25 && i < DataCount * 0.75) {
	  trapezoidal_wave[i] = 1 * DAC_Range;
	}
	else if(i >= DataCount * 0.75) {
	  trapezoidal_wave[i] = ((DataCount / (DataCount * 0.25)) * (DataCount - i)) / DataCount * DAC_Range;
	}
  }
}

//triangular wave
void set_triangular_wave() {
  for(int i = 0; i < DataCount; i++) {
	if(i < DataCount * 0.5) {
	  triangular_wave[i] =  (DataCount / (DataCount * 0.5) * i) / DataCount * DAC_Range;
	}
	else if(i >= DataCount * 0.5) {
	  triangular_wave[i] = ((DataCount / (DataCount * 0.5)) * (DataCount - i)) / DataCount * DAC_Range;
	}
  }
}

//initialize
void Initialization() {
  LCD_initial();    //initialize lcd
  LCD_Puts("Wave Type:");    //write sting
  LCD_GoTo_Position(1, 0);    //move to LCD position
  LCD_Puts("Sawtooth Wave");    //sawtooth wave
  HAL_GPIO_WritePin(GPIOB, led0, GPIO_PIN_SET);    //turn on LED
  set_sawtooth_wave();    //sawtooth wave
  set_square_wave();    //square wave
  set_sine_wave();    //sine wave
  set_trapezoidal_wave();    //trapezoidal wave
  set_triangular_wave();    //triangular wave
  //HAL_DAC_Start(&hdac1, DAC_CHANNEL_1);    //start DAC
  //HAL_TIM_Base_Start_IT(&htim2);    //start timer interrupt
  HAL_DAC_Init(&hdac1);    //DAC initialization
  HAL_TIM_Base_Start(&htim2);    //start timer
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim){
  //float sample_value;
  switch(wave_type) {
    //sawtooth
    case 0:
	  sample_value = sawtooth_wave[value_index];
	  break;
    //square wave
    case 1:
	  sample_value = square_wave[value_index];
	  break;
    //sine wave
    case 2:
	  sample_value = sine_wave[value_index];
	  break;
    //trapezoidal_wave
    case 3:
	  sample_value = trapezoidal_wave[value_index];
	  break;
    //triangular wave
    case 4:
	  sample_value = triangular_wave[value_index];
	  break;
    default:
	  sample_value = 0.0;
	  break;
  }
  //uint32_t DACData = ((uint32_t)(sample_value * DAC_Range / 3.3));    //convert to 12-bit value
  //HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, DACData);    //output analog signal

  uint8_t NextIndex = value_index + 1;    //next index
  //next step
  value_index = (NextIndex >= DataCount) ? 0 : NextIndex;
}

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin){
  HAL_DAC_Stop_DMA(&hdac1, DAC_CHANNEL_1);
  uint8_t type_value = wave_type + 1;    //add counter number
  //check wave type
  wave_type = (type_value > 4) ? 0 : type_value;
  switch(wave_type) {
    //sawtooth
    case 0:
	  HAL_DAC_Start_DMA(&hdac1, DAC_CHANNEL_1, (uint32_t*)sawtooth_wave, DataCount, DAC_ALIGN_12B_R);
	  break;
    //square wave
    case 1:
      HAL_DAC_Start_DMA(&hdac1, DAC_CHANNEL_1, (uint32_t*)square_wave, DataCount, DAC_ALIGN_12B_R);
      break;
    //sine wave
    case 2:
      HAL_DAC_Start_DMA(&hdac1, DAC_CHANNEL_1, (uint32_t*)sine_wave, DataCount, DAC_ALIGN_12B_R);
      break;
    //trapezoidal_wave
    case 3:
      HAL_DAC_Start_DMA(&hdac1, DAC_CHANNEL_1, (uint32_t*)trapezoidal_wave, DataCount, DAC_ALIGN_12B_R);
      break;
    //triangular wave
    case 4:
      HAL_DAC_Start_DMA(&hdac1, DAC_CHANNEL_1, (uint32_t*)triangular_wave, DataCount, DAC_ALIGN_12B_R);
      break;
    default:
      break;
    }



  lcd_flag = 1;    //set LCD flag
  HAL_GPIO_TogglePin(GPIOA, GPIO_PIN_5);
}
